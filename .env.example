# Copy to .env.local for local overrides. Every variable is optional locally.

# Postgres connection string (Neon free tier in production, provisioned by the credential broker).
# Leave empty locally: the app then uses an embedded PGlite database in .data/pglite.
DATABASE_URL=

# Random string that Vercel Cron sends as "Authorization: Bearer <value>" to /api/cron/alerts.
# The route refuses to run without it.
CRON_SECRET=

# Resend API key. Without it, alerts are queued but not sent, and sign-in links are printed to the
# dev server console instead of emailed (on Vercel, sign-in refuses to run without it).
# Email-forward intake reads received emails, which needs a full-access key, not a sending-only one.
RESEND_API_KEY=

# Signing secret of the Resend webhook for the email.received event (Resend dashboard → Webhooks).
# /api/intake/email refuses every request without it.
RESEND_WEBHOOK_SECRET=

# Resend's receiving domain, e.g. "abc123.resend.app" (not secret). Each account forwards POs to
# po-<token>@<this domain>. Leave empty to offer only the "paste an email" box.
INTAKE_EMAIL_DOMAIN=

# Sender address, e.g. "LienClock <alerts@your-verified-domain>". Defaults to Resend's test sender.
ALERT_FROM_EMAIL=

# Support address shown on /privacy and /terms (not secret), e.g. "help@your-domain". Leave empty to
# show no contact line; the pages then point only to the self-serve delete controls.
CONTACT_EMAIL=

# Stripe billing (LienClock Pro, $29/month). It switches on only when both STRIPE_PAYMENT_LINK and
# STRIPE_WEBHOOK_SECRET are set; until then every account is unlimited and free (early access).
# No Stripe API key is needed: payment goes through a Payment Link, and a webhook records who paid.
# The Payment Link's URL (not secret), e.g. "https://buy.stripe.com/<link id>".
STRIPE_PAYMENT_LINK=
# Signing secret of the Stripe webhook endpoint https://<host>/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.updated, customer.subscription.deleted).
# /api/stripe/webhook refuses every request without it.
STRIPE_WEBHOOK_SECRET=
# Optional, not secret: the customer portal's login link (Stripe → Settings → Billing → Customer portal),
# where subscribers cancel or change their card. Shown as "Manage billing or cancel" on /jobs.
STRIPE_PORTAL_URL=

# Public base URL used in alert emails, sign-in links, the calendar feed address, robots.txt and the sitemap.
# Defaults to https://$VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
APP_URL=
