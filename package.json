{
  "name": "lienclock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preliminary-notice and lien deadline tracker for small subcontractors",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "cf:build": "NEXT_PUBLIC_DEPLOY_ENV=production APP_URL=https://lienclock.1426davejobs.workers.dev opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "cf:preview": "wrangler dev"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
